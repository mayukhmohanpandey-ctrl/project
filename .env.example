# Pick ONE provider by setting its key. Sharpen auto-detects it.

# Groq (https://console.groq.com/keys). Default model: openai/gpt-oss-120b
GROQ_API_KEY=your-groq-key-here

# xAI Grok (https://console.x.ai). Default model: grok-4.7
# XAI_API_KEY=your-xai-key-here

# --- Optional ---
# LLM_PROVIDER=groq            # groq | xai | nvidia | openai | ollama | custom (needed only if several keys are set)
# LLM_MODEL=openai/gpt-oss-120b  # override the model. Check the provider's current model list: models get retired
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b   # tried in order if a model no longer exists
# LLM_REASONING_EFFORT=low     # Groq gpt-oss only: low | medium | high
# LLM_TIMEOUT=90               # seconds
# LLM_BASE_URL=                # custom OpenAI-compatible endpoint (also needs LLM_MODEL)
# NVIDIA_API_KEY= / OPENAI_API_KEY=   # other supported providers
# RATE_LIMIT_PER_MIN=12        # per client IP; "compare" counts as 2
# TRUST_PROXY=1                # behind Render/Heroku/nginx
# DEMO_MODE=1                  # canned responses, no key needed
# PORT=8000
